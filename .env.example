EXPO_PUBLIC_API_BASE_URL=https://laz1310-fastapi-enaeaghwfhbhgsa9.canadacentral-01.azurewebsites.net

# Native Firebase files are not committed. Point these variables at local files
# or configure them as EAS file environment variables.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# App Check debug tokens are secrets. Configure FIREBASE_APP_CHECK_DEBUG_TOKEN
# in the EAS development environment, never in EXPO_PUBLIC_* variables.

# Optional public OAuth WEB client ID (not a client secret).
# If already present, Google Sign-In uses an ID token. If absent, the native
# Google SDK provides an access token that Firebase Authentication can exchange.
# This is NOT needed in Azure FastAPI and does NOT block Metro sign-in.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
